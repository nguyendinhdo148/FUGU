{
  "redirects": [
    {
      "source": "/our-story/",
      "destination": "/our-story",
      "permanent": true
    },
    {
      "source": "/blog/",
      "destination": "/blog",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/our-story",
      "destination": "/our-story.html"
    },
    {
      "source": "/blog",
      "destination": "/blog.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}